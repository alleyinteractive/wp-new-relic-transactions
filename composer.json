{
    "name": "alleyinteractive/wp-new-relic-transactions",
    "description": "A companion plugin when using New Relic with WordPress, to improve the recorded transaction data.",
    "type": "wordpress-plugin",
    "keywords": [
        "alleyinteractive",
        "wp-new-relic-transactions"
    ],
    "homepage": "https://github.com/alleyinteractive/wp-new-relic-transactions",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Matthew Boynes",
            "email": "info+git@alley.com"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "alleyinteractive/alley-coding-standards": "^2.6",
        "alleyinteractive/composer-wordpress-autoloader": "^1.4",
        "mantle-framework/testkit": "^1.22",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "alleyinteractive/composer-wordpress-autoloader": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "autoload-dev": {
        "psr-4": {
            "Alley\\WP_New_Relic_Transactions\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "phpcbf": "phpcbf .",
        "phpcs": "phpcs .",
        "phpstan": "phpstan --memory-limit=512M",
        "lint": [
            "@phpcs",
            "@phpstan"
        ],
        "lint:fix": [
            "@phpcbf"
        ],
        "phpunit": "phpunit",
        "release": "npx @alleyinteractive/create-release@latest",
        "test": [
            "@lint",
            "@phpunit"
        ]
    }
}
